import numpy as np

def euler_integrator(f, q, y0, steps, dt):

    """
    Integrates the ODE dy/dt = f(y) using the Euler method.

    f: function
        The function f(y,q) that defines the ODE of the form r$dot{y}(t) = f(y,q)$,
        where r$dot{y}(t)$ might be a vector.
        The integrator is written in such a way, that functions with additional parameters q can also be
        investigated.
    q: array like
        Additional paramteres for the function f. The exact form depends on the definition of f.
        If f(y,q)=f(y), then insert a dummy value for q for the integrator to work.
    y0: float
        The initial condition for y at t=0.
    steps: int
        The number of time steps to integrate.
    dt: float
        The time step size.
    """
    # make sure the initial value is an array
    y0 = np.asarray(y0, dtype=float)
    
    # Initialize 2D storage: rows are time steps, columns are state variables
    y = np.zeros((int(steps) + 1, len(y0)))
    y[0] = y0

    # integration step
    for i in range(1, int(steps) + 1):
        y[i] = y[i-1] + dt * f(y[i-1],q)

    return y


def improved_euler_integrator(f, q, y0, steps, dt):

    """
    Integrates the ODE dy/dt = f(y) using the Improved Euler (Heun) method.

    f: function
        The function f(y,q) that defines the ODE of the form r$dot{y}(t) = f(y,q)$,
        where r$dot{y}(t)$ might be a vector.
        The integrator is written in such a way, that functions with additional parameters q can also be
        investigated.
    q: array like
        Additional paramteres for the function f. The exact form depends on the definition of f.
        If f(y,q)=f(y), then insert a dummy value for q for the integrator to work.
    y0: float
        The initial condition for y at t=0.
    steps: int
        The number of time steps to integrate.
    dt: float
        The time step size.
    """
    # make sure the initial value is an array
    y0 = np.asarray(y0, dtype=float)
        
    # initialize 2D storage: rows are time steps, columns are state variables
    y = np.zeros((int(steps) + 1, len(y0)))
    y[0] = y0

    # integration step
    for i in range(1, int(steps) + 1):
        k1 = f(y[i-1],q)
        k2 = f(y[i-1] + dt * k1,q)
        y[i] = y[i-1] + (dt / 2) * (k1 + k2)

    return y


def rk4(f, q, y0, steps, dt):

    """
    Integrates the ODE dy/dt = f(y) using the Runge-Kutta 4 method.

    f: function
        The function f(y,q) that defines the ODE of the form r$dot{y}(t) = f(y,q)$,
        where r$dot{y}(t)$ might be a vector.
        The integrator is written in such a way, that functions with additional parameters q can also be
        investigated.
    q: array like
        Additional paramteres for the function f. The exact form depends on the definition of f.
        If f(y,q)=f(y), then insert a dummy value for q for the integrator to work.
    y0: array like
        The initial condition for y at t=0.
    steps: int
        The number of time steps to integrate.
    dt: float
        The time step size.
    """
    # make sure the initial value is an array
    y0 = np.asarray(y0, dtype=float)
    
    # Initialize 2D storage: rows are time steps, columns are state variables
    y = np.zeros((int(steps) + 1, len(y0)))
    y[0] = y0

    # integration step
    for i in range(1, int(steps) + 1):
        k1 = f(y[i-1],q)
        k2 = f(y[i-1] + (dt / 2) * k1,q)
        k3 = f(y[i-1] + (dt / 2) * k2,q)
        k4 = f(y[i-1] + dt * k3,q)
        y[i] = y[i-1] + (dt / 6) * (k1 + 2*k2 + 2*k3 + k4)

    return y